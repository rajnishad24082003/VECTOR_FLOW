          <mxGeometry x="540" y="265" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="with _pending_lock: append (prefix+text, Future)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="360" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="acquire _model_lock (wait for any running pass)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
