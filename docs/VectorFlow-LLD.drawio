          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="yes (another thread&#10;encoded it)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c14">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="110" y="540" />
              <mxPoint x="110" y="862" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c26" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Why&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; torch already uses OMP_NUM_THREADS cores per pass; parallel passes thrash the CPU.&lt;/div&gt;&lt;div&gt;&amp;bull; Under load N waiting queries cost ~1 pass instead of N sequential passes.&lt;/div&gt;&lt;div&gt;&amp;bull; Measured at concurrency 16: p99 212 → 161 ms, throughput ≈ +20%.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a33a;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;B. Session context maths (app/sessions.py)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;&lt;b&gt;&lt;u&gt;blend_query(q, ctx, w)  — applied before search&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;if ctx is None or w ≤ 0:  q_search = q&lt;/div&gt;&lt;div&gt;else:  q_search = normalize((1 − w) · q + w · ctx)        default w = 0.3&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;&lt;b&gt;&lt;u&gt;record_query(...)  — applied after search&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;ctx₁ = q₁&lt;/div&gt;&lt;div&gt;ctxₙ = normalize(d · ctxₙ₋₁ + (1 − d) · qₙ)        default d = 0.6&lt;/div&gt;&lt;div&gt;Note: the stored context uses the raw query vector qₙ, not the blended one, so context cannot amplify itself.&lt;/div&gt;&lt;div&gt;queries  ← (queries + [query])[-20:]&lt;/div&gt;&lt;div&gt;seen_ids ← ordered set; ids returned again move to the end; keep last 500&lt;/div&gt;&lt;div&gt;updated_at ← now&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;&lt;b&gt;&lt;u&gt;Example&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&quot;rockets and moon landings&quot; → &quot;what are the latest missions&quot;: space documents rank higher than with the bare query; exclude_seen then surfaces unseen documents (e.g. James Webb telescope).&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="80" width="640" height="268" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;C. build_filter(filters, exclude_ids) — kNN pre-filter&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;Input:  {&quot;category&quot;: &quot;tech&quot;, &quot;tags&quot;: [&quot;a&quot;, 1], &quot;active&quot;: true},  exclude_ids = [&quot;x&quot;]&lt;/div&gt;&lt;div&gt;Output: {&quot;bool&quot;: {&quot;filter&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&quot;term&quot;:  {&quot;metadata.category&quot;: &quot;tech&quot;}},&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&quot;terms&quot;: {&quot;metadata.tags&quot;: [&quot;a&quot;, &quot;1&quot;]}},&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&quot;term&quot;:  {&quot;metadata.active&quot;: &quot;true&quot;}}],&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&quot;must_not&quot;: [{&quot;ids&quot;: {&quot;values&quot;: [&quot;x&quot;]}}]}}&lt;/div&gt;&lt;div&gt;Applied inside knn.filter, so HNSW only considers matching documents and still returns k results when possible.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="560" width="640" height="169" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;b&gt;D. Startup: lifespan + ElasticVectorStore.ensure_index&lt;/b&gt;" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;1. HFEmbedder()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Load model in thread pool; read dim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="965" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="&lt;b&gt;2. wait_until_ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cluster.health yellow; ConnectionError → sleep 2 s, max 30 tries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="965" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;3. indices.exists?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No → _create_index (resource_already_exists_exception ignored: another worker won)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="500" y="965" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="&lt;b&gt;4. Dimension check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;get_mapping → embedding.dims must equal model dim, else RuntimeError&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="730" y="965" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;5. Index health&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cluster.health(index, yellow, 30 s)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="960" y="965" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="&lt;b&gt;6. Session store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RedisSessionStore(url, ttl) or InMemorySessionStore(ttl)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1190" y="965" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="&lt;b&gt;7. Warm-up + publish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;embed_documents([&quot;warm up&quot;]); set app.state.*; yield&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1420" y="965" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c39" value="&lt;b&gt;8. Shutdown&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AsyncExitStack closes Redis and ES clients (also on failed startup)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1650" y="965" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c32" target="c33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c33" target="c34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c34" target="c35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c35" target="c36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c36" target="c37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c38" target="c39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. Data Model &amp; Config" id="5.-data-model-&amp;-config">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="803" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;VectorFlow — Low Level Design: Storage Schemas &amp;amp; Configuration&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Elasticsearch index: vectorflow-docs&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;VF_ES_INDEX&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;&lt;b&gt;&lt;u&gt;settings&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;number_of_shards: 1 · number_of_replicas: 0 · refresh_interval: 1s&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;&lt;b&gt;&lt;u&gt;mappings.properties&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;_id: keyword&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Client-supplied id or uuid4 hex.&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;title: text&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Optional; also prepended to the embedded text.&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;text: text&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Document body (required).&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;metadata: flattened&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Arbitrary JSON object; every leaf filterable as metadata.&amp;lt;key&amp;gt; keyword.&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;created_at: date&lt;/font&gt;&lt;/b&gt;&lt;br&gt;UTC ISO timestamp set at index time.&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;embedding: dense_vector(dims=384, index=true, similarity=cosine)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;index_options: int8_hnsw, m=16, ef_construction=100. Excluded from _source in search responses.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;&lt;b&gt;&lt;u&gt;Score&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;_score = (1 + cosine) / 2  ∈ [0, 1]&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="560" height="370" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Redis session record&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;Key&lt;/font&gt;&lt;/b&gt;&lt;br&gt;vf:session:&amp;lt;32-char uuid4 hex&amp;gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;Command&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SET key value EX 1800 on every save (sliding TTL); GET; DEL&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;Value (JSON)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;{&quot;id&quot;: &quot;...&quot;, &quot;created_at&quot;: 1791378950.93, &quot;updated_at&quot;: 1791378951.07, &quot;queries&quot;: [&quot;rockets and moon landings&quot;, ...], &quot;seen_ids&quot;: [&quot;doc-030&quot;, ...], &quot;context&quot;: &quot;&amp;lt;base64 of 384 × float32 = 1536 bytes&amp;gt;&quot; | null}&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;Size&lt;/font&gt;&lt;/b&gt;&lt;br&gt;≈ 2 KB context + history + up to 500 ids&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;Server config&lt;/font&gt;&lt;/b&gt;&lt;br&gt;--save &quot;&quot; --appendonly no --maxmemory 256mb --maxmemory-policy volatile-lru&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="560" height="251" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Settings (VF_* environment variables)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_ES_URL = http://localhost:9200&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Elasticsearch endpoint&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_ES_API_KEY = None&lt;/font&gt;&lt;/b&gt;&lt;br&gt;API key when ES security is on&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_ES_INDEX = vectorflow-docs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Index name&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_ES_TIMEOUT_SECONDS = 10&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Request timeout&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_ES_STARTUP_RETRIES = 30&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Startup connection attempts (2 s apart)&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_REDIS_URL = redis://localhost:6379/0&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Empty → in-memory sessions&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_EMBEDDING_MODEL = all-MiniLM-L6-v2&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Any sentence-transformers model&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_EMBEDDING_DEVICE = cpu&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cpu / cuda&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_EMBEDDING_BATCH_SIZE = 64&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Document encode chunk size&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_QUERY_PREFIX / VF_DOCUMENT_PREFIX = &quot;&quot;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;e.g. &quot;query: &quot; / &quot;passage: &quot; for e5&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_QUERY_CACHE_SIZE = 4096&lt;/font&gt;&lt;/b&gt;&lt;br&gt;LRU entries per worker&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_NUM_CANDIDATES_FACTOR = 10&lt;/font&gt;&lt;/b&gt;&lt;br&gt;num_candidates = k × factor&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_SESSION_TTL_SECONDS = 1800&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Idle expiry&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_SESSION_CONTEXT_WEIGHT = 0.3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;w in blend_query&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_SESSION_DECAY = 0.6&lt;/font&gt;&lt;/b&gt;&lt;br&gt;d in record_query&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_SESSION_HISTORY_SIZE = 20&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Queries kept&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;VF_SESSION_MAX_SEEN = 500&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Seen ids kept&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;WEB_CONCURRENCY / OMP_NUM_THREADS = 2 / 4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;uvicorn workers / torch threads per worker&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1240" y="80" width="560" height="663" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Docker artefacts&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;Dockerfile&lt;/font&gt;&lt;/b&gt;&lt;br&gt;python:3.12-slim → pip install CPU torch → requirements.txt → download VF_EMBEDDING_MODEL into HF_HOME=/opt/hf-cache → HF_HUB_OFFLINE=1 → copy app/ → non-root user vf (uid 1000) → HEALTHCHECK GET /health → CMD uvicorn app.main:app --host 0.0.0.0 --port 8000&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;docker-compose.yml&lt;/font&gt;&lt;/b&gt;&lt;br&gt;elasticsearch (8.15.3, single-node, security off, 1 GB heap, disk threshold off, volume esdata, curl healthcheck) · redis (7-alpine, ephemeral, redis-cli ping healthcheck, no host port) · api (build ., env VF_ES_URL / VF_REDIS_URL / WEB_CONCURRENCY / OMP_NUM_THREADS, port 8000, depends_on healthy, restart unless-stopped)&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a3d7c&quot; face=&quot;Courier New&quot;&gt;.dockerignore&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Excludes .venv, tests, scripts, data, docs and .env from the build context.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1160" height="184" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>