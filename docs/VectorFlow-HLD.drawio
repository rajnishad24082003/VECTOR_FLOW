        <mxCell id="c7" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;DELETE /sessions/{session_id}&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;End a session&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; 204: deleted&lt;/div&gt;&lt;div&gt;&amp;bull; 404: not found or expired&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="860" y="378" width="780" height="96" as="geometry" />
