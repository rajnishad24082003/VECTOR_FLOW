        <mxCell id="c9" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;GET /docs · /openapi.json&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Auto-generated OpenAPI / Swagger UI&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Interactive documentation generated by FastAPI from the Pydantic schemas&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
