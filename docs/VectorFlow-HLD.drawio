        <mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;GET /health&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Dependency health&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; 200: {status: &quot;ok&quot;, elasticsearch: true, sessions: true, model, documents}&lt;/div&gt;&lt;div&gt;&amp;bull; 503: status &quot;degraded&quot; when ES or the session store is unreachable&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
