<mxfile host="app.diagrams.net" type="device">
  <diagram name="1. System Architecture" id="1.-system-architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;VectorFlow — High Level Design: System Architecture&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Semantic Search API  |  Python 3.12 · FastAPI · Hugging Face sentence-transformers · Elasticsearch 8.15 · Redis 7 · Docker Compose" style="text;html=1;fontSize=12;align=left;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;API Clients&lt;/b&gt;&lt;br&gt;Web/mobile frontends, backend services, curl, Swagger UI (/docs)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Operator Scripts&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;run on host, talk HTTP&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; scripts/ingest.py — bulk load JSONL or a Hugging Face dataset via POST /documents&lt;/div&gt;&lt;div&gt;&amp;bull; scripts/benchmark.py — concurrent load test of POST /search, reports p50/p95/p99&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="220" height="154" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Docker Compose host&lt;/b&gt; (docker-compose.yml)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#333333;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="1100" height="760" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;vectorflow-api&lt;/b&gt; container — image &lt;i&gt;vectorflow:latest&lt;/i&gt; (python:3.12-slim, CPU torch, model baked in)&lt;br&gt;uvicorn · WEB_CONCURRENCY=2 workers · OMP_NUM_THREADS=4 · port 8000 · non-root user · HEALTHCHECK /health" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f7ee;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="560" height="690" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;HTTP Layer&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;app/main.py · app/api.py · app/schemas.py&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; FastAPI app factory create_app() with lifespan startup/shutdown&lt;/div&gt;&lt;div&gt;&amp;bull; Routes: /documents, /search, /sessions, /health (+ OpenAPI /docs)&lt;/div&gt;&lt;div&gt;&amp;bull; Pydantic request/response validation (limits on k, batch size, query length)&lt;/div&gt;&lt;div&gt;&amp;bull; Middleware adds X-Response-Time-Ms header to every response&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="215" width="520" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Embedding Service&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;app/embeddings.py · HFEmbedder&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; all-MiniLM-L6-v2 → 384-dim L2-normalised vectors&lt;/div&gt;&lt;div&gt;&amp;bull; LRU cache (4096) for query vectors&lt;/div&gt;&lt;div&gt;&amp;bull; Micro-batching of concurrent queries into one forward pass&lt;/div&gt;&lt;div&gt;&amp;bull; Model lock prevents CPU oversubscription&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="360" width="250" height="169" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Session Service&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;app/sessions.py&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Session model: context vector, query history, seen ids&lt;/div&gt;&lt;div&gt;&amp;bull; blend_query / record_query context maths&lt;/div&gt;&lt;div&gt;&amp;bull; RedisSessionStore (prod) or InMemorySessionStore (fallback)&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="640" y="360" width="250" height="154" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Vector Store Adapter&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;app/store.py · ElasticVectorStore&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Creates/validates index (dense_vector int8_hnsw, cosine), race-safe across workers&lt;/div&gt;&lt;div&gt;&amp;bull; Bulk indexing, filtered kNN search, delete, count, ping&lt;/div&gt;&lt;div&gt;&amp;bull; Metadata filters → term/terms on flattened field; exclude-seen → ids must_not&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="370" y="549" width="520" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;Configuration&lt;/b&gt; — app/config.py Settings (pydantic-settings), all overridable via &lt;b&gt;VF_*&lt;/b&gt; env vars / .env" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="370" y="694" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Elasticsearch 8.15.3&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;single node · port 9200 · volume esdata&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; API calls: _bulk, _search (knn), _count, indices.*, cluster.health&lt;/div&gt;&lt;div&gt;&amp;bull; Index vectorflow-docs: 1 shard, 0 replicas, refresh 1s&lt;/div&gt;&lt;div&gt;&amp;bull; embedding: dense_vector 384, cosine, int8_hnsw (m=16, ef_construction=100)&lt;/div&gt;&lt;div&gt;&amp;bull; title/text: text · metadata: flattened · created_at: date&lt;/div&gt;&lt;div&gt;&amp;bull; Security disabled for dev; disk watermark check disabled (dev only)&lt;/div&gt;&lt;div&gt;&amp;bull; Heap 1 GB (ES_JAVA_OPTS)&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1020" y="200" width="370" height="212" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Redis 7 (alpine)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;internal network only · no host port&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; API calls: GET, SET EX, DEL, PING&lt;/div&gt;&lt;div&gt;&amp;bull; Key vf:session:&amp;lt;id&amp;gt; → session JSON&lt;/div&gt;&lt;div&gt;&amp;bull; SET ... EX 1800 (sliding TTL refreshed on each save)&lt;/div&gt;&lt;div&gt;&amp;bull; Ephemeral: no RDB/AOF persistence&lt;/div&gt;&lt;div&gt;&amp;bull; maxmemory 256mb, policy volatile-lru&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="520" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Hugging Face Hub&lt;/b&gt;&lt;br&gt;sentence-transformers/all-MiniLM-L6-v2&lt;br&gt;&lt;i&gt;(build time only)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1480" y="170" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Docker image build&lt;/b&gt;&lt;br&gt;Dockerfile downloads model into HF_HOME; runtime sets HF_HUB_OFFLINE=1 → becomes the vectorflow-api image" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1480" y="330" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="HTTP/JSON :8000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="embed text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="get/save session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="query vector" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="exclude seen ids" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="HTTP :9200" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="RESP :6379" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="model download" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c14" target="c15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Key Design Decisions &amp;amp; Non-Functional Characteristics&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Stateless API workers: all session state lives in Redis, so the API can scale horizontally behind a load balancer.&lt;/div&gt;&lt;div&gt;&amp;bull; Latency (20k AG News docs, 12-core laptop): p99 27 ms at concurrency 1, 87 ms at concurrency 8 (125 req/s), 161 ms at 16 (148 req/s). ES kNN stays ~10 ms; CPU embedding dominates under load.&lt;/div&gt;&lt;div&gt;&amp;bull; Latency levers: int8-quantised HNSW, query-embedding LRU cache, micro-batching, WEB_CONCURRENCY × OMP_NUM_THREADS ≤ cores, model baked into image + warm-up at startup.&lt;/div&gt;&lt;div&gt;&amp;bull; Continuous query context: each session keeps an exponentially decaying average of past query vectors that is blended into new queries.&lt;/div&gt;&lt;div&gt;&amp;bull; Resilience: API waits for ES (30 retries × 2 s), compose healthchecks gate startup order, restart: unless-stopped, /health returns 503 when a dependency is down.&lt;/div&gt;&lt;div&gt;&amp;bull; Scale-out paths: more API replicas, GPU embedding (VF_EMBEDDING_DEVICE=cuda), ES shards/replicas for larger corpora.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#fffbe6;strokeColor=#b7a33a;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Legend&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Green = HTTP/API layer&lt;/div&gt;&lt;div&gt;&amp;bull; Blue = embeddings&lt;/div&gt;&lt;div&gt;&amp;bull; Orange = Elasticsearch/vector store&lt;/div&gt;&lt;div&gt;&amp;bull; Purple = sessions/Redis&lt;/div&gt;&lt;div&gt;&amp;bull; Red = operator scripts&lt;/div&gt;&lt;div&gt;&amp;bull; Dashed arrow = build-time&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1480" y="480" width="220" height="154" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Functional Modules" id="2.-functional-modules">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="677" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;VectorFlow — High Level Design: Functional Modules &amp;amp; Responsibilities&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Document Ingestion&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Accepts 1–1000 documents per request: optional id, optional title, text, free-form metadata.&lt;/div&gt;&lt;div&gt;&amp;bull; Embeds &quot;title. text&quot; (or text) with the document prefix, in chunks of 64.&lt;/div&gt;&lt;div&gt;&amp;bull; Bulk-indexes into Elasticsearch; ids are generated (uuid4) when absent; re-using an id overwrites.&lt;/div&gt;&lt;div&gt;&amp;bull; Optional refresh=wait_for so documents are searchable on return; scripts use refresh=false for speed.&lt;/div&gt;&lt;div&gt;&amp;bull; Returns indexed count, failed count, ids and took_ms.&lt;/div&gt;&lt;div&gt;&amp;bull; Delete by id (404 if the document does not exist).&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="520" height="183" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Semantic Search&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Embeds the query (cached + micro-batched) into a 384-dim normalised vector.&lt;/div&gt;&lt;div&gt;&amp;bull; Approximate kNN on the HNSW index: k results (1–100), num_candidates = k × 10.&lt;/div&gt;&lt;div&gt;&amp;bull; Exact-match metadata filters (single value → term, list → terms; booleans as &quot;true&quot;/&quot;false&quot;).&lt;/div&gt;&lt;div&gt;&amp;bull; Returns id, cosine score ((1+cos)/2), title, text, metadata, plus embed/search/total timings.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="590" y="80" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Stateful Sessions&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Create / inspect / delete sessions; sessions expire after 30 min idle (sliding TTL).&lt;/div&gt;&lt;div&gt;&amp;bull; Context vector = decaying average of query vectors (decay 0.6); blended into new queries (weight 0.3).&lt;/div&gt;&lt;div&gt;&amp;bull; use_context=false opts a single query out of blending.&lt;/div&gt;&lt;div&gt;&amp;bull; exclude_seen=true skips documents already returned in the session (up to 500 remembered).&lt;/div&gt;&lt;div&gt;&amp;bull; Keeps the last 20 query strings for inspection.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="80" width="520" height="169" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Embedding Engine&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Hugging Face sentence-transformers model loaded once per worker at startup and warmed up.&lt;/div&gt;&lt;div&gt;&amp;bull; Configurable model, device, batch size and query/document prefixes (for e5/bge models).&lt;/div&gt;&lt;div&gt;&amp;bull; LRU cache of query vectors (4096 entries) — repeated queries skip the model.&lt;/div&gt;&lt;div&gt;&amp;bull; Concurrent queries coalesced into one forward pass; one forward pass at a time per worker.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="293" width="520" height="154" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Health &amp;amp; Observability&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; GET /health pings Elasticsearch and the session store and reports document count and model.&lt;/div&gt;&lt;div&gt;&amp;bull; 200 &quot;ok&quot; when all dependencies are up, 503 &quot;degraded&quot; otherwise (used by Docker HEALTHCHECK).&lt;/div&gt;&lt;div&gt;&amp;bull; X-Response-Time-Ms header on every response; per-stage timings in search responses.&lt;/div&gt;&lt;div&gt;&amp;bull; Structured logging for startup, index creation and bulk failures.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="590" y="250" width="520" height="154" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Configuration &amp;amp; Deployment&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; All settings in one Settings class, overridable via VF_* environment variables or .env.&lt;/div&gt;&lt;div&gt;&amp;bull; Three containers: api, elasticsearch, redis; healthchecks gate startup order.&lt;/div&gt;&lt;div&gt;&amp;bull; Image ships CPU-only torch and the pre-downloaded model; runs as non-root.&lt;/div&gt;&lt;div&gt;&amp;bull; Startup validates index vector dimension against the model to prevent silent corruption.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1140" y="279" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Operator Tooling&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; ingest.py: stream JSONL or Hugging Face datasets, batch to POST /documents, progress + docs/s.&lt;/div&gt;&lt;div&gt;&amp;bull; benchmark.py: concurrent /search load with unique queries, client and server latency percentiles.&lt;/div&gt;&lt;div&gt;&amp;bull; Test suite: fake embedder + in-memory vector store, so tests need neither torch nor Elasticsearch.&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="477" width="520" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. Request Flows" id="3.-request-flows">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;VectorFlow — High Level Design: Key Request Flows&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;A. Semantic search (POST /search)&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;1. Validate request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SearchRequest: query 1–2048 chars, k 1–100, filters, session_id, use_context, exclude_seen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;2. Load session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;If session_id: GET from Redis. Missing/expired → 404&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;3. Embed query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LRU cache hit ≈1 ms; miss → micro-batched model pass ≈8 ms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="480" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;4. Blend context&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;If session has context and use_context: normalize(0.7·q + 0.3·ctx)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="700" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;5. kNN search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ES knn: k, num_candidates=k×10, metadata filters, must_not seen ids&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="920" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;6. Update session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fold query vector into context (decay 0.6), append query, add result ids to seen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1140" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;7. Save session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SET vf:session:&amp;lt;id&amp;gt; EX 1800 (refreshes TTL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1360" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;8. Respond&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hits + context_applied + timings {embed, search, total}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1580" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;B. Document ingestion (POST /documents)&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;1. Read source&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ingest.py streams JSONL lines or a Hugging Face dataset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;2. Batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Groups of 256 documents (configurable --batch-size)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="345" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;b&gt;3. Validate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IndexRequest: 1–1000 docs, text required&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="480" y="345" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;4. Compose text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&quot;title. text&quot; when a title exists, else text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="700" y="345" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;5. Embed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Chunks of 64 under the model lock (queries can interleave)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="920" y="345" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;6. Bulk index&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;async_bulk to ES; ids generated if absent; created_at stamped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1140" y="345" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;7. Respond&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;indexed, failed, ids, took_ms; script prints docs/s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1360" y="345" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;C. Session lifecycle&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="&lt;b&gt;1. Create&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /sessions → new uuid, saved to Redis with TTL → 201&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;2. Search within session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /search with session_id; context grows with each query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="340" y="555" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="&lt;b&gt;3. Inspect&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /sessions/{id} → queries, seen_count, has_context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="555" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;4. End&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DELETE /sessions/{id} → 204, or automatic expiry after 30 min idle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="940" y="555" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c33" target="c34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c34" target="c35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c35" target="c36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;D. Service startup (FastAPI lifespan, per worker)&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="&lt;b&gt;1. Load model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HFEmbedder in a thread (from baked HF cache, offline)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="755" width="210" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;2. Connect ES&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AsyncElasticsearch; wait for cluster yellow (30 × 2 s retries)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="286" y="755" width="210" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="&lt;b&gt;3. Ensure index&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Create if missing (race-safe), check vector dims, wait index yellow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="532" y="755" width="210" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;4. Session store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Redis if VF_REDIS_URL set, otherwise in-memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="778" y="755" width="210" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c45" value="&lt;b&gt;5. Warm up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;One embedding pass so the first request is not slow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1024" y="755" width="210" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;6. Ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Services on app.state; shutdown closes ES and Redis clients&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1270" y="755" width="210" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c41" target="c42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c42" target="c43">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c43" target="c44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c44" target="c45">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c45" target="c46">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. API Endpoints" id="4.-api-endpoints">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="710" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;VectorFlow — High Level Design: REST API Contract&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;POST /documents&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Index documents&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Body: {documents: [{id?, title?, text, metadata?}] (1–1000), refresh: bool = true}&lt;/div&gt;&lt;div&gt;&amp;bull; 200: {indexed, failed, ids[], took_ms}&lt;/div&gt;&lt;div&gt;&amp;bull; 422: validation error&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="780" height="111" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;DELETE /documents/{doc_id}&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Delete a document&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; 204: deleted&lt;/div&gt;&lt;div&gt;&amp;bull; 404: document not found&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="780" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;POST /search&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Semantic kNN search, optionally within a session&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; Body: {query (1–2048), k = 10 (1–100), session_id?, filters?: {key: value | [values]}, use_context = true, exclude_seen = false}&lt;/div&gt;&lt;div&gt;&amp;bull; 200: {query, session_id, context_applied, hits[{id, score, title, text, metadata}], timings{embed_ms, search_ms, total_ms}}&lt;/div&gt;&lt;div&gt;&amp;bull; 404: session not found or expired&lt;/div&gt;&lt;div&gt;&amp;bull; 422: validation error&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="860" y="200" width="780" height="154" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;POST /sessions&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Start a session&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; 201: {id, created_at, updated_at, queries[], seen_count, has_context}&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="780" height="82" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;GET /sessions/{session_id}&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Inspect a session&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&amp;bull; 200: SessionOut&lt;/div&gt;&lt;div&gt;&amp;bull; 404: not found or expired&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
