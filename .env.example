# Copy to .env for local (non-Docker) runs. All settings: app/config.py
VF_ES_URL=http://localhost:9200
VF_REDIS_URL=redis://localhost:6379/0
VF_ES_INDEX=vectorflow-docs
VF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VF_NUM_CANDIDATES_FACTOR=10
VF_SESSION_TTL_SECONDS=1800
VF_SESSION_CONTEXT_WEIGHT=0.3
VF_SESSION_DECAY=0.6
